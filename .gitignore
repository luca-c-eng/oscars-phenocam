# oscars-phenocam — repository ignore rules
#
# Keep source code, documentation, system definitions and *_example.txt
# configuration templates under version control.
# Operational configuration and runtime-generated data must never be committed.

# -----------------------------------------------------------------------------
# Operational configuration
# -----------------------------------------------------------------------------

/software/config/settings.txt
/software/config/server.txt
/software/config/ftp_credentials.txt
/software/config/known_hosts
/software/config/keys/

# Prevent accidental copies of operational configuration at repository root.

/settings.txt
/server.txt
/ftp_credentials.txt
/known_hosts
/keys/

# PhenoCam SSH identity generated during installation.

**/phenocam_key
**/phenocam_key.pub

# -----------------------------------------------------------------------------
# Runtime files
# -----------------------------------------------------------------------------

*.log
*.log.*
*.lock
*.pid
*.tmp

# -----------------------------------------------------------------------------
# Generated capture pairs
# -----------------------------------------------------------------------------

*_????_??_??_??????.jpg
*_????_??_??_??????.meta

# -----------------------------------------------------------------------------
# Operating-system files
# -----------------------------------------------------------------------------

.DS_Store
Thumbs.db
[Dd]esktop.ini

# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------

.vscode/
.idea/

*.swp
*.swo
*~
*.bak
*.orig
*.rej
