[Unit]
Description=PhenoCam upload drain
After=network-online.target phenocam-init.service run-phenocam.mount
Wants=network-online.target
Requires=phenocam-init.service run-phenocam.mount

[Service]
Type=oneshot
User=phenocam
Group=phenocam
TimeoutStartSec=900
ExecStart=/usr/local/lib/phenocam/bin/phenocam-upload.sh

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/phenocam /var/log/phenocam /var/lib/phenocam /media /mnt /etc/phenocam
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
