[Unit]
Description=PhenoCam startup test cycle (capture + upload)
After=network-online.target phenocam-init.service run-phenocam.mount
Wants=network-online.target
Requires=phenocam-init.service run-phenocam.mount

[Service]
Type=oneshot
User=phenocam
Group=phenocam
SupplementaryGroups=video
ExecStart=/usr/local/lib/phenocam/bin/phenocam-startup-cycle.sh
TimeoutStartSec=1500

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/phenocam /var/log/phenocam /var/lib/phenocam /media /mnt
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
