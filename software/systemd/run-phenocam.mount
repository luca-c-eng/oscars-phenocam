[Unit]
Description=RAMDISK for PhenoCam queue
Documentation=file:/usr/local/lib/phenocam/docs/README.md

[Mount]
What=tmpfs
Where=/run/phenocam
Type=tmpfs
# Default fallback. phenocam-init-ramdisk.sh rewrites this line at boot with
# board-aware size and numeric uid/gid for the phenocam user.
Options=size=100m,mode=0750

[Install]
WantedBy=multi-user.target
